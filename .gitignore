## NuGet pack output
artifacts/

# scratch dir for the depth-consolidation training experiment
data-deepen/

# scratch dirs for the brute-force cube-davi campaigns
cube-10b/
cube-20b/

# scratch dir for the EfficientCube (cube-policy) campaign
cube-policy/

# Polyglot-generated TypeScript twins — emitted by `dotnet build` (pgconfig.json include rules).
# They must exist on disk for the Angular compile, but are build outputs, not source.
src/RLDemo.Web/ClientApp/src/app/**/*_solver.ts
# Polyglot 0.10.0 emits a v3 source map beside each TS twin when PolyglotOriginInfo=true (M63).
# Same status as the twin itself: a build output, never committed.
src/RLDemo.Web/ClientApp/src/app/**/*_solver.ts.map

# Level packs copied from the Environments project by the CopyLevelPacks build target. The canonical files live
# in src/MintPlayer.AI.ReinforcementLearning.Environments/<Game>/levels/ and are embedded there for training;
# these copies exist only so the browser fetches the identical bytes.
src/RLDemo.Web/wwwroot/levels/

# Python bytecode from the level-pack importer tools.
__pycache__/

# M63.7: the TS-side .pg cobertura produced by tools/pg_coverage_remap.mjs in CI.
coverage-ts/
