<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MintPlayer.AI.ReinforcementLearning.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The RLDemo.Web reference pulls in NodeServices' buildTransitive targets, which
         would try to npm-install a ClientApp\ that doesn't exist here. Tests host the
         backend only (Program.cs skips the SPA under "Testing"), so disable the SPA
         builder outright — CI does the same via -p:EnableSpaBuilder=false. -->
    <EnableSpaBuilder>false</EnableSpaBuilder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MintPlayer.AI.ReinforcementLearning.Core\MintPlayer.AI.ReinforcementLearning.Core.csproj" />
    <ProjectReference Include="..\..\src\MintPlayer.AI.ReinforcementLearning.Environments\MintPlayer.AI.ReinforcementLearning.Environments.csproj" />
    <ProjectReference Include="..\..\src\MintPlayer.AI.ReinforcementLearning.Ilgpu\MintPlayer.AI.ReinforcementLearning.Ilgpu.csproj" />
    <ProjectReference Include="..\..\src\MintPlayer.AI.ReinforcementLearning.Campaigns\MintPlayer.AI.ReinforcementLearning.Campaigns.csproj" />
    <ProjectReference Include="..\..\src\RLDemo.Web\RLDemo.Web.csproj" />
    <!-- Only CliArgs (still internal to the Lab exe, via InternalsVisibleTo) is tested from here. Aliased so
         the Lab exe's generated top-level `Program` doesn't collide with RLDemo.Web's in WebApplicationFactory. -->
    <ProjectReference Include="..\..\tools\MintPlayer.AI.ReinforcementLearning.Lab\MintPlayer.AI.ReinforcementLearning.Lab.csproj" Aliases="Lab" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>