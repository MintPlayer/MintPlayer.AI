<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>RLNet.Web</RootNamespace>
		<IsPackable>false</IsPackable>
		<SpaRoot>ClientApp\</SpaRoot>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MintPlayer.AspNetCore.SpaServices" Version="10.4.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\RL.NET.Core\RL.NET.Core.csproj" />
		<ProjectReference Include="..\RL.NET.Environments\RL.NET.Environments.csproj" />
	</ItemGroup>

	<!-- Angular production build during publish (dev uses the SPA dev-server middleware).
	     The Dockerfile builds the SPA in a dedicated Node stage and sets SkipAngularPublish. -->
	<Target Name="PublishAngular" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipAngularPublish)' != 'true'">
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

		<ItemGroup>
			<DistFiles Include="$(SpaRoot)dist\ClientApp\browser\**" />
			<ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
				<RelativePath>ClientApp\dist\ClientApp\browser\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
