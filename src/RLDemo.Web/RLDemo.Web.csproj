<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>RLDemo.Web</RootNamespace>
		<IsPackable>false</IsPackable>
		<SpaRoot>ClientApp\</SpaRoot>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MintPlayer.AspNetCore.SpaServices" Version="10.5.0" />
		<PackageReference Include="MintPlayer.SourceGenerators" Version="10.20.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="MintPlayer.SourceGenerators.Attributes" Version="10.20.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.AI.ReinforcementLearning.Core\MintPlayer.AI.ReinforcementLearning.Core.csproj" />
		<ProjectReference Include="..\MintPlayer.AI.ReinforcementLearning.Environments\MintPlayer.AI.ReinforcementLearning.Environments.csproj" />
		<!-- Shared RL runtime DI: AddReinforcementLearning(dataDir) registers the model store + clock (same
		     surface the AIHost training tools use), so the web and the Lab wire the runtime identically. -->
		<ProjectReference Include="..\MintPlayer.AI.ReinforcementLearning.Hosting\MintPlayer.AI.ReinforcementLearning.Hosting.csproj" />
		<!-- GPU backend: the self-taught cube solver uses a resident GPU forward when a CUDA device is
		     present (local dev); ILGPU falls back cleanly to CPU when there is none (e.g. Hetzner).
		     AddGpuBackend() lives in Ilgpu.Hosting; the compute package comes transitively. -->
		<ProjectReference Include="..\MintPlayer.AI.ReinforcementLearning.Ilgpu.Hosting\MintPlayer.AI.ReinforcementLearning.Ilgpu.Hosting.csproj" />
	</ItemGroup>

	<!-- Level content, single source of truth: these JSON packs live in the Environments project (embedded there
	     for training) and are LINKED — not copied — into wwwroot/levels, so the Angular app fetches the exact
	     same bytes the C# campaign trains against. Regenerate with `python tools/blockdude_levels.py` /
	     `python tools/lunarlockout_levels.py`; never hand-edit, and never duplicate a pack into wwwroot. -->
	<ItemGroup>
		<Content Include="..\MintPlayer.AI.ReinforcementLearning.Environments\BlockDude\levels\blockdude-levels.json"
		         Link="wwwroot\levels\blockdude-levels.json" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\MintPlayer.AI.ReinforcementLearning.Environments\LunarLockout\levels\lunarlockout-levels.json"
		         Link="wwwroot\levels\lunarlockout-levels.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Angular production build during publish (dev uses the SPA dev-server middleware).
	     The Dockerfile builds the SPA in a dedicated Node stage and sets SkipAngularPublish. -->
	<Target Name="PublishAngular" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipAngularPublish)' != 'true'">
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

		<ItemGroup>
			<DistFiles Include="$(SpaRoot)dist\ClientApp\browser\**" />
			<ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
				<RelativePath>ClientApp\dist\ClientApp\browser\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
