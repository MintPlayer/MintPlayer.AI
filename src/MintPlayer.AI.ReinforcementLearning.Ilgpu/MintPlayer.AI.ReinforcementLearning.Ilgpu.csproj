<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MintPlayer.AI.ReinforcementLearning.Ilgpu</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Version>$(RLNetVersion)</Version>
    <Authors>Pieterjan De Clippel</Authors>
    <Company>MintPlayer</Company>
    <Description>Optional GPU compute backend for MintPlayer.AI.ReinforcementLearning, implemented with ILGPU (CUDA / OpenCL / CPU accelerators). Implements IComputeBackend so it slots in under the autograd layer without touching algorithm code. Never a dependency of the Core package.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>reinforcement-learning;gpu;cuda;ilgpu;gemm</PackageTags>
    <RepositoryUrl>https://github.com/MintPlayer/MintPlayer.AI</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MintPlayer.AI.ReinforcementLearning.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MintPlayer.AI.ReinforcementLearning.Core\MintPlayer.AI.ReinforcementLearning.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILGPU" Version="1.5.3" />
  </ItemGroup>

</Project>
