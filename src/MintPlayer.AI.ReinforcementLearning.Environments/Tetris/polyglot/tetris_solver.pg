// tetris_solver.pg — single-source Tetris engine (docs/prd/TETRIS_PRD.md §3.1). ONE source, transpiled to
// C# and TS; types are `PgTet`-prefixed (every .pg emits into the same global C# namespace).
//
// Everything the browser needs — rules, placement enumeration, per-placement features, the observation,
// the scripted tiers (random / Dellacherie / search) and the net forward pass — lives here, so C#
// training/serving and the web page share one engine. All rules arithmetic is i32 (f64 only in
// features/observation/net); rows are 10-bit i32 bitmasks (bit c = column c filled — values ≤ 1023, so
// only `<< >> & |` on small positives are ever needed). Every rule is deterministic; planning (the
// per-placement evaluation and the search tiers) consumes NO RNG.
//
// Two step APIs over one lock path (PRD §3.10 / risk 4):
//   • MACRO (AI/env): action = rot·10 + col ∈ [0,40), hard vertical drop — applyPlacement().
//   • MICRO (human): spawn/left/right/rotate/softDrop/hardDrop on an active piece — same lock,
//     scoring, garbage and spawn bookkeeping via afterLock().

import { List } from "std.collections"
import { Math } from "std.math"

// Exact i32 quotient of a non-negative dividend (same rationale as the other solvers' divExact —
// unique name: module-level fns from every .pg share one C# class).
fn tetDiv(a: i32, b: i32): i32 => (a - a % b) / b

// ── Deterministic RNG — minstd Lehmer LCG via Schrage (identical to PgCfRng; own copy because the TS
// twins are separate modules). Byte-identical streams in .NET int and JS number.
class PgTetRng {
  const M: i32 = 2147483647
  const A: i32 = 48271
  const Q: i32 = 44488
  const R: i32 = 3399

  var state: i32

  constructor(seed: i32) {
    var s = seed % M
    if s < 0 { s += M - 1 }
    if s == 0 { s = 1 }
    this.state = s
  }

  fn next(): i32 {
    let r = this.state % Q
    let q = tetDiv(this.state, Q)
    var s = A * r - R * q
    if s <= 0 { s += M }
    this.state = s
    return s
  }

  fn nextInt(n: i32): i32 => this.next() % n
}

// ── The game ───────────────────────────────────────────────────────────────────────────────────────────────
class PgTetris {
  const W: i32 = 10
  const H: i32 = 20
  const FullRow: i32 = 1023          // (1 << W) − 1
  const PieceCount: i32 = 7          // 0=I 1=O 2=T 3=S 4=Z 5=L 6=J
  const ActionCount: i32 = 40        // rot·10 + col
  // Training-reward bonus for a 4-line clear, in lines units (owner decision 2026-08-26: the AI should
  // build for and clear tetrises). reward = lines + (lines==4 ? bonus : 0) — a tetris pays 12 vs 4 for
  // four singles. Superlinear SCORE as the raw reward was rejected (the stack-and-camp trap, PRD §3.5);
  // netSearchAction's rollout reward must use the same units as training (TetrisEnv mirrors this const).
  const RewardTetrisBonus: i32 = 8

  // ── M57.1 tetris-aware evaluator (PRD TETRIS_TECHNIQUES §3.1, spike results §6.R) ──────────────────
  // The Dellacherie basis is ANTI-TETRIS: its wellSum term penalises the very well a tetris needs, so a
  // policy maximising it flattens the stack and burns singles (measured: 0.08 tetrises/episode). Splitting
  // the well term — penalise wells everywhere EXCEPT the designated well column — plus StackRabbit's
  // tetris-aware terms measured +59% score, CI-separated, with 9× the tetrises (spike S0/S0b).
  // Weights must be scaled TO THIS BASIS. Copying StackRabbit's absolute values (it prices holes at −50
  // where Dellacherie prices them at −4) over-weights the tetris terms ~12×, drowns the safety terms and
  // tops out 100% of the time — measured, S0. Every weight below was then CEM-tuned in that scale.
  // Weights CEM-tuned 2026-08-30 (spike S5) under a CONSTRAINED fitness — A-score and tetrises multiplied
  // by min(1, B_survival/364), so survival below the M54 baseline scales the whole objective down and
  // cannot be bought back with score. Held-out (seeds 9000+): A 161,902 / 6.30 tetrises per episode /
  // TRT 13.9% / B 325.6 — against the M54 baseline of A 94,636 / 0.26 tetrises / B 363.8.
  const WellCol: i32 = 9             // right well: the vertical I favours it, and it is 4 taps from spawn
  const EvalHoles: f64 = -5.582      // (was the Dellacherie -4)
  const EvalWells: f64 = -0.847      // wells OUTSIDE the well column (was -1)
  const EvalReady: f64 = 3.402       // rows complete except the well column
  const EvalCovered: f64 = -0.201    // the well is capped — the tetris is gone until it is dug out
  const EvalBurn: f64 = -3.700       // per line cleared that is NOT a tetris: makes a single COST something
  const EvalBurnDig: f64 = -0.650    // ...but on a holed board burning is SURVIVAL — relax it (DIG mode)
  const EvalHoleDig: f64 = -0.505    // extra hole pressure while digging out
  const EvalCol9: f64 = -0.355       // column 8 tall ⇒ the well is sealed from the 4-tap side
  const EvalTetris: f64 = 7.047      // realised 4-line clear
  const EvalMaxSafeCol9: i32 = 8
  const ObsPlanes: i32 = 16          // per-action planes; 0-5 ARE the M54 basis (obs indices 214..453)
  const EvalInaccessible: f64 = -0.975 // per row of stack above the height at which a wall is still reachable

  // Tap budget (PRD §4.1): frames per shift. 6 = DAS 10Hz (the ROM auto-repeat), 5 = hypertapping 12Hz,
  // 3 = rolling 20Hz, 2 = the 30Hz hardware ceiling. Drives BOTH the reachability terms below and (M57.3)
  // the legality mask. Default DAS — the ROM behaviour, and the most restrictive human setting.
  var tapFramesPerShift: i32 = 6

  // Piece tables, built in constructor() (instance lists, NOT module-level lets — the module-globals-in-methods
  // fix is post-0.8.1). Rotation slot r of piece p lives at rotIdx = p·4 + r; each rotation holds 4 cells
  // at cellX/cellY[rotIdx·4 + k], bounding box rotW/rotH[rotIdx], and per-column bottom profile
  // rotBottom[rotIdx·4 + x] (max cell y in that column; −1 for x ≥ rotW).
  //
  // The shapes and the (rot+1) cycle order match the NES ROM's orientation table ($8A9C) and A-button
  // (clockwise) rotation table ($88EE) exactly; rotOffX/rotOffY give each state's NRS box offset from
  // the piece ORIGIN (the pivot the NES keeps per falling piece), and spawnRot the NES spawn state —
  // together they make micro rotation a true in-place pivot (M55.3). The MACRO placement API is
  // origin-agnostic (normalized boxes × columns), so the AI/net/parity surface is untouched.
  var rotCount: List<i32> = List<i32>()
  var rotW: List<i32> = List<i32>()
  var rotH: List<i32> = List<i32>()
  var cellX: List<i32> = List<i32>()
  var cellY: List<i32> = List<i32>()
  var rotBottom: List<i32> = List<i32>()
  var rotOffX: List<i32> = List<i32>()   // NRS box top-left minus origin, per rotation slot
  var rotOffY: List<i32> = List<i32>()
  var spawnRot: List<i32> = List<i32>()  // NES spawn state per piece (as a rot slot index)

  // Board: H row bitmasks, row 0 = top.
  var rows: List<i32> = List<i32>()
  // Which cells arrived as GARBAGE (parallel bitmasks, moved in lockstep with rows through clears and
  // shifts; player pieces are never marked) — the render's grey tint reads this, never a heuristic.
  var garbageMasks: List<i32> = List<i32>()

  var pieceRng: PgTetRng = PgTetRng(1)
  var garbageRng: PgTetRng = PgTetRng(1)
  var useBag: bool                   // 7-bag (web default) vs uniform (training/benchmark)
  var bag: List<i32> = List<i32>()
  var bagPos: i32

  var current: i32                   // piece in play (the macro action places it)
  var next: i32                      // 1-piece preview
  var score: i32                     // NES score: 40/100/300/1200 per 1/2/3/4 lines, × (level+1)
  var lines: i32                     // total lines cleared (the training-reward currency)
  var tetrises: i32                  // 4-line clears (the owner's headline metric)
  var level: i32                     // NES progression (see levelForLines) — honours startLevel
  // M57 / gate G7: NES start-level selection. S3 measured that tap speed constrains NOTHING at level 0
  // (48 frames/row) and becomes decisive at 19+ — so every metric taken from a level-0 start is blind to
  // the regime where real play happens. Default 0 keeps every pre-M57 protocol byte-identical.
  var startLevel: i32 = 0
  var piecesPlaced: i32
  var gameOver: bool
  var lastLinesCleared: i32          // of the most recent lock

  // Rising-garbage mode (PRD §1): every garbageEvery placements a full bottom row with one random gap
  // pushes the stack up; overflow = game over. 0 = off.
  var garbageEvery: i32
  var garbageCounter: i32

  // Micro (human) piece state — macro play never reads these.
  var activeRot: i32
  var activeX: i32
  var activeY: i32
  var activeLive: bool               // false between lock and the next microSpawn

  // Per-placement eval scratch, set by simPlace (valid immediately after the call).
  var simLanding: f64                // H − dropY − rotH/2 (spike's midpoint landing height)
  var simEroded: i32                 // linesCleared × piece cells inside the cleared rows

  constructor() {
    this.useBag = false
    this.bagPos = 0
    this.current = 0
    this.next = 0
    this.score = 0
    this.lines = 0
    this.tetrises = 0
    this.level = 0
    this.piecesPlaced = 0
    this.gameOver = false
    this.lastLinesCleared = 0
    this.garbageEvery = 0
    this.garbageCounter = 0
    this.activeRot = 0
    this.activeX = 0
    this.activeY = 0
    this.activeLive = false
    this.simLanding = 0.0
    this.simEroded = 0
    this.buildPieceTables()
    for i in 0..H { this.rows.add(0) }
    for i3 in 0..H { this.garbageMasks.add(0) }
  }

  // ── Piece data (spike shapes, spawn orientations; simple rotation, no kicks) ─────────────────────────────
  fn addRot(x0: i32, y0: i32, x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32) {
    this.cellX.add(x0)
    this.cellY.add(y0)
    this.cellX.add(x1)
    this.cellY.add(y1)
    this.cellX.add(x2)
    this.cellY.add(y2)
    this.cellX.add(x3)
    this.cellY.add(y3)
  }

  fn addEmptyRot() {
    this.addRot(0, 0, 0, 0, 0, 0, 0, 0)
  }

  fn addOff(dx: i32, dy: i32) {
    this.rotOffX.add(dx)
    this.rotOffY.add(dy)
  }

  fn buildPieceTables() {
    // I
    this.rotCount.add(2)
    this.addRot(0, 0, 1, 0, 2, 0, 3, 0)
    this.addRot(0, 0, 0, 1, 0, 2, 0, 3)
    this.addEmptyRot()
    this.addEmptyRot()
    // O
    this.rotCount.add(1)
    this.addRot(0, 0, 1, 0, 0, 1, 1, 1)
    this.addEmptyRot()
    this.addEmptyRot()
    this.addEmptyRot()
    // T
    this.rotCount.add(4)
    this.addRot(0, 0, 1, 0, 2, 0, 1, 1)
    this.addRot(1, 0, 0, 1, 1, 1, 1, 2)
    this.addRot(1, 0, 0, 1, 1, 1, 2, 1)
    this.addRot(0, 0, 0, 1, 1, 1, 0, 2)
    // S
    this.rotCount.add(2)
    this.addRot(1, 0, 2, 0, 0, 1, 1, 1)
    this.addRot(0, 0, 0, 1, 1, 1, 1, 2)
    this.addEmptyRot()
    this.addEmptyRot()
    // Z
    this.rotCount.add(2)
    this.addRot(0, 0, 1, 0, 1, 1, 2, 1)
    this.addRot(1, 0, 0, 1, 1, 1, 0, 2)
    this.addEmptyRot()
    this.addEmptyRot()
    // L
    this.rotCount.add(4)
    this.addRot(0, 0, 0, 1, 0, 2, 1, 2)
    this.addRot(0, 0, 1, 0, 2, 0, 0, 1)
    this.addRot(0, 0, 1, 0, 1, 1, 1, 2)
    this.addRot(2, 0, 0, 1, 1, 1, 2, 1)
    // J
    this.rotCount.add(4)
    this.addRot(1, 0, 1, 1, 0, 2, 1, 2)
    this.addRot(0, 0, 0, 1, 1, 1, 2, 1)
    this.addRot(0, 0, 1, 0, 0, 1, 0, 2)
    this.addRot(0, 0, 1, 0, 2, 0, 2, 1)

    // NRS origin offsets per rotation slot (box top-left − origin; ROM $8A9C, meatfighter tables) and
    // the NES spawn state per piece. Origin spawns at (5, 0); every spawn state has dy = 0.
    // I: Ih(−2,0) Iv(0,−2)
    this.addOff(-2, 0)
    this.addOff(0, -2)
    this.addOff(0, 0)
    this.addOff(0, 0)
    // O: (−1,0)
    this.addOff(-1, 0)
    this.addOff(0, 0)
    this.addOff(0, 0)
    this.addOff(0, 0)
    // T: Td(−1,0) Tl(−1,−1) Tu(−1,−1) Tr(0,−1)
    this.addOff(-1, 0)
    this.addOff(-1, -1)
    this.addOff(-1, -1)
    this.addOff(0, -1)
    // S: Sh(−1,0) Sv(0,−1)
    this.addOff(-1, 0)
    this.addOff(0, -1)
    this.addOff(0, 0)
    this.addOff(0, 0)
    // Z: Zh(−1,0) Zv(0,−1)
    this.addOff(-1, 0)
    this.addOff(0, -1)
    this.addOff(0, 0)
    this.addOff(0, 0)
    // L: Lr(0,−1) Ld(−1,0) Ll(−1,−1) Lu(−1,−1)
    this.addOff(0, -1)
    this.addOff(-1, 0)
    this.addOff(-1, -1)
    this.addOff(-1, -1)
    // J: Jl(−1,−1) Ju(−1,−1) Jr(0,−1) Jd(−1,0)
    this.addOff(-1, -1)
    this.addOff(-1, -1)
    this.addOff(0, -1)
    this.addOff(-1, 0)
    // Spawn states: I=Ih(0) O=0 T=Td(0) S=Sh(0) Z=Zh(0) L=Ld(1) J=Jd(3)
    this.spawnRot.add(0)
    this.spawnRot.add(0)
    this.spawnRot.add(0)
    this.spawnRot.add(0)
    this.spawnRot.add(0)
    this.spawnRot.add(1)
    this.spawnRot.add(3)

    // Bounding boxes + bottom profiles for all 28 rotation slots.
    for ri in 0..(PieceCount * 4) {
      var w = 0
      var h = 0
      for k in 0..4 {
        if this.cellX[ri * 4 + k] + 1 > w { w = this.cellX[ri * 4 + k] + 1 }
        if this.cellY[ri * 4 + k] + 1 > h { h = this.cellY[ri * 4 + k] + 1 }
      }
      this.rotW.add(w)
      this.rotH.add(h)
      for bx in 0..4 {
        var bottom = -1
        for k2 in 0..4 {
          if this.cellX[ri * 4 + k2] == bx && this.cellY[ri * 4 + k2] > bottom { bottom = this.cellY[ri * 4 + k2] }
        }
        this.rotBottom.add(bottom)
      }
    }
  }

  // ── Reset / piece stream ─────────────────────────────────────────────────────────────────────────────────
  // NES A-TYPE level curve with a selectable start level. The first level-up arrives after
  // min(startLevel*10 + 10, max(100, startLevel*10 - 50)) lines, then every 10 thereafter — the ROM's
  // rule, which is why an 18-start reaches 19 at 130 lines and the 29 kill screen at 230.
  fn levelForLines(clearedLines: i32): i32 {
    if this.startLevel == 0 { return tetDiv(clearedLines - clearedLines % 10, 10) }
    let a = this.startLevel * 10 + 10
    let b0 = this.startLevel * 10 - 50
    let b = if b0 > 100 { b0 } else { 100 }
    let first = if a < b { a } else { b }
    if clearedLines < first { return this.startLevel }
    let extra = clearedLines - first
    return this.startLevel + 1 + tetDiv(extra - extra % 10, 10)
  }

  // Set the NES start level. Call AFTER reset (reset clears it back to 0).
  fn setStartLevel(lvl: i32) {
    this.startLevel = lvl
    this.level = this.levelForLines(this.lines)
  }

  fn reset(seed: i32, sevenBag: bool, garbageRate: i32) {
    this.startLevel = 0
    this.pieceRng = PgTetRng(seed)
    this.garbageRng = PgTetRng(seed + 1000003)
    this.useBag = sevenBag
    this.bag.clear()
    this.bagPos = 0
    this.rows.clear()
    for i in 0..H { this.rows.add(0) }
    this.garbageMasks.clear()
    for i4 in 0..H { this.garbageMasks.add(0) }
    this.score = 0
    this.lines = 0
    this.tetrises = 0
    this.level = 0
    this.piecesPlaced = 0
    this.gameOver = false
    this.lastLinesCleared = 0
    this.garbageEvery = garbageRate
    this.garbageCounter = 0
    this.activeLive = false
    this.current = this.drawPiece()
    this.next = this.drawPiece()
  }

  fn refillBag() {
    this.bag.clear()
    for p in 0..PieceCount { this.bag.add(p) }
    for i2 in 0..(PieceCount - 1) {
      let i = PieceCount - 1 - i2
      let j = this.pieceRng.nextInt(i + 1)
      let tmp = this.bag[i]
      this.bag[i] = this.bag[j]
      this.bag[j] = tmp
    }
    this.bagPos = 0
  }

  fn drawPiece(): i32 {
    if !this.useBag { return this.pieceRng.nextInt(PieceCount) }
    if this.bagPos >= PieceCount { this.refillBag() }
    if this.bag.count == 0 { this.refillBag() }
    let p = this.bag[this.bagPos]
    this.bagPos += 1
    return p
  }

  // ── Geometry ─────────────────────────────────────────────────────────────────────────────────────────────
  // NES validity: x in bounds, bottom in bounds, and cells may sit up to 2 rows ABOVE the visible board
  // (the ROM check accepts y ≥ −2; those virtual rows are always empty) — that head-room is what lets a
  // piece rotate on its spawn row. The MACRO path only ever passes y ≥ 0, so it is unaffected.
  fn fitsAt(piece: i32, rot: i32, x: i32, y: i32): bool {
    let ri = piece * 4 + rot
    if x < 0 || x + this.rotW[ri] > W { return false }
    if y < -2 || y + this.rotH[ri] > H { return false }
    for k in 0..4 {
      let cx = x + this.cellX[ri * 4 + k]
      let cy = y + this.cellY[ri * 4 + k]
      if cy >= 0 && ((this.rows[cy] >> cx) & 1) == 1 { return false }
    }
    return true
  }

  // Hard-drop landing row (top of bounding box) for a vertical drop from above; −1 = illegal (out of
  // range, or no room at the top — the spike's top-out placement rule).
  fn dropY(piece: i32, rot: i32, x: i32): i32 {
    if rot < 0 || rot >= this.rotCount[piece] { return -1 }
    if !this.fitsAt(piece, rot, x, 0) { return -1 }
    var y = 0
    for _step in 0..H {
      if this.fitsAt(piece, rot, x, y + 1) { y += 1 } else { break }
    }
    return y
  }

  // ── Lock primitives (shared by macro and micro paths — risk 4) ───────────────────────────────────────────
  // Write the piece, clear full rows, and record the eval scratch (landing height + eroded cells).
  // Pure board mutation: no RNG, no scoring, no spawn — the planning/search tiers call this on saved rows.
  fn simPlace(piece: i32, rot: i32, x: i32, y: i32): i32 {
    let ri = piece * 4 + rot
    for k in 0..4 {
      let cy = y + this.cellY[ri * 4 + k]
      this.rows[cy] = this.rows[cy] | (1 << (x + this.cellX[ri * 4 + k]))
    }
    var pieceCellsCleared = 0
    for k2 in 0..4 {
      if this.rows[y + this.cellY[ri * 4 + k2]] == FullRow { pieceCellsCleared += 1 }
    }
    let cleared = this.clearFullRows()
    this.simLanding = (H - y) - this.rotH[ri] / 2.0
    this.simEroded = cleared * pieceCellsCleared
    return cleared
  }

  fn clearFullRows(): i32 {
    var cleared = 0
    var write = H - 1
    for i in 0..H {
      let y = H - 1 - i
      if this.rows[y] == FullRow {
        cleared += 1
      } else {
        this.rows[write] = this.rows[y]
        this.garbageMasks[write] = this.garbageMasks[y]
        write -= 1
      }
    }
    for w2 in 0..(write + 1) {
      this.rows[w2] = 0
      this.garbageMasks[w2] = 0
    }
    return cleared
  }

  // NES-style line scoring (owner decision 2026-08-26): a tetris pays 30× a single — the score the AI
  // is asked to maximize rewards building for 4-line clears. Multiplied by (level+1) in afterLock.
  fn lineScore(cleared: i32): i32 {
    if cleared == 1 { return 40 }
    if cleared == 2 { return 100 }
    if cleared == 3 { return 300 }
    if cleared == 4 { return 1200 }
    return 0
  }

  // NES gravity curve: frames per one-row drop at 60 fps (levels 0–8 step down 48→8, then the classic
  // plateaus; 29+ is the "kill screen" 1 frame/row). Single-sourced so the web timer and any future
  // speed-aware logic agree. The AI's placement decisions have no gravity clock (benchmark convention).
  fn gravityFrames(lvl: i32): i32 {
    if lvl <= 8 { return 48 - 5 * lvl }
    if lvl == 9 { return 6 }
    if lvl <= 12 { return 5 }
    if lvl <= 15 { return 4 }
    if lvl <= 18 { return 3 }
    if lvl <= 28 { return 2 }
    return 1
  }

  // Post-lock bookkeeping shared by both step APIs: scoring, counters, the garbage clock, and the next
  // piece draw. Does NOT decide game-over for the new piece — each path applies its own rule after this.
  fn afterLock(cleared: i32) {
    this.lines += cleared
    if cleared == 4 { this.tetrises += 1 }
    // NES progression; points use the level AFTER a level-up (NES rule).
    this.level = this.levelForLines(this.lines)
    this.score += this.lineScore(cleared) * (this.level + 1)
    this.lastLinesCleared = cleared
    this.piecesPlaced += 1
    if this.garbageEvery > 0 {
      this.garbageCounter += 1
      if this.garbageCounter >= this.garbageEvery {
        this.garbageCounter = 0
        this.insertGarbageRow()
      }
    }
    this.current = this.next
    this.next = this.drawPiece()
  }

  fn insertGarbageRow() {
    if this.rows[0] != 0 {
      this.gameOver = true
      return
    }
    for y in 0..(H - 1) {
      this.rows[y] = this.rows[y + 1]
      this.garbageMasks[y] = this.garbageMasks[y + 1]
    }
    let mask = FullRow - (1 << this.garbageRng.nextInt(W))
    this.rows[H - 1] = mask
    this.garbageMasks[H - 1] = mask
  }

  // ── MACRO step API (AI/env): action = rot·10 + col ───────────────────────────────────────────────────────
  fn actionRot(action: i32): i32 => tetDiv(action, W)
  fn actionCol(action: i32): i32 => action % W

  fn placementLegal(action: i32): bool {
    if this.gameOver || action < 0 || action >= ActionCount { return false }
    return this.dropY(this.current, this.actionRot(action), this.actionCol(action)) >= 0
  }

  fn legalMask(): List<bool> {
    var mask: List<bool> = List<bool>()
    for a in 0..ActionCount { mask.add(this.placementLegal(a)) }
    return mask
  }

  fn hasLegalPlacement(): bool {
    for a in 0..ActionCount { if this.placementLegal(a) { return true } }
    return false
  }

  // Apply a placement end-to-end (lock, clear, score, garbage clock, draw). Returns the LINES cleared
  // (0–4, the training-reward currency; display score accrues separately) or −1 for an illegal action.
  // The board tops out — gameOver — when the NEW current piece has no legal placement (all-masked ⇒
  // terminated, PRD §3.3) or the garbage shift overflows.
  fn applyPlacement(action: i32): i32 {
    if !this.placementLegal(action) { return -1 }
    let rot = this.actionRot(action)
    let x = this.actionCol(action)
    let y = this.dropY(this.current, rot, x)
    let cleared = this.simPlace(this.current, rot, x, y)
    this.afterLock(cleared)
    if !this.gameOver && !this.hasLegalPlacement() { this.gameOver = true }
    return cleared
  }

  // ── MICRO step API (human play). Same lock path; rotation is simple (no kicks) ───────────────────────────
  // NES spawn: the piece origin appears at (5, 0) in its piece-specific spawn state; the box top-left is
  // origin + the state's NRS offset (every spawn state has dy = 0).
  fn microSpawn(): bool {
    let sr = this.spawnRot[this.current]
    this.activeRot = sr
    this.activeX = 5 + this.rotOffX[this.current * 4 + sr]
    this.activeY = 0
    this.activeLive = this.fitsAt(this.current, sr, this.activeX, 0)
    if !this.activeLive { this.gameOver = true }
    return this.activeLive
  }

  fn microShift(dx: i32): bool {
    if !this.activeLive || this.gameOver { return false }
    if !this.fitsAt(this.current, this.activeRot, this.activeX + dx, this.activeY) { return false }
    this.activeX += dx
    return true
  }

  // NES rotation (M55.3, owner decision: pure NRS): the piece pivots IN PLACE about its origin — the new
  // state's box lands at origin + its NRS offset (so the box top-left moves by the offset delta, the
  // origin never moves), and the rotation succeeds iff the new state's four TARGET cells are free
  // (diagonal neighbours are irrelevant — a T in a snug slot rotates). No kicks of any kind: blocked by
  // wall, floor, or stack ⇒ nothing happens. The (rot+1) cycle IS the NES A-button (clockwise) order.
  fn microRotate(): bool {
    if !this.activeLive || this.gameOver { return false }
    let cur = this.current * 4 + this.activeRot
    let nr = (this.activeRot + 1) % this.rotCount[this.current]
    let nxt = this.current * 4 + nr
    let nx = this.activeX - this.rotOffX[cur] + this.rotOffX[nxt]
    let ny = this.activeY - this.rotOffY[cur] + this.rotOffY[nxt]
    if !this.fitsAt(this.current, nr, nx, ny) { return false }
    this.activeRot = nr
    this.activeX = nx
    this.activeY = ny
    return true
  }

  // One gravity/soft-drop step: true if the piece LOCKED (lastLinesCleared holds the clear count).
  fn microDropStep(): bool {
    if !this.activeLive || this.gameOver { return false }
    if this.fitsAt(this.current, this.activeRot, this.activeX, this.activeY + 1) {
      this.activeY += 1
      return false
    }
    this.microLock()
    return true
  }

  fn microHardDrop(): bool {
    if !this.activeLive || this.gameOver { return false }
    for _step in 0..H {
      if this.fitsAt(this.current, this.activeRot, this.activeX, this.activeY + 1) { this.activeY += 1 } else { break }
    }
    this.microLock()
    return true
  }

  fn microLock() {
    // Locking with cells in the virtual rows above the board (activeY < 0 — every state's box has a
    // cell in its top row) is a top-out: the NES lets those cells vanish and the next spawn fails; we
    // end the game one lock earlier — same outcome, and no negative row indices reach simPlace.
    if this.activeY < 0 {
      this.activeLive = false
      this.gameOver = true
      return
    }
    let cleared = this.simPlace(this.current, this.activeRot, this.activeX, this.activeY)
    this.activeLive = false
    this.afterLock(cleared)
    if !this.gameOver { this.microSpawn() }
  }

  // ── Per-placement features (spike math, ported verbatim — the C# gate reproduces the spike bars) ─────────
  fn rowTransitions(): i32 {
    var t = 0
    for y in 0..H {
      var prev = 1
      for c in 0..W {
        let cur = (this.rows[y] >> c) & 1
        if cur != prev { t += 1 }
        prev = cur
      }
      if prev == 0 { t += 1 }
    }
    return t
  }

  fn colTransitions(): i32 {
    var t = 0
    for c in 0..W {
      var prev = 0
      for y in 0..H {
        let cur = (this.rows[y] >> c) & 1
        if cur != prev { t += 1 }
        prev = cur
      }
      if prev == 0 { t += 1 }
    }
    return t
  }

  fn holes(): i32 {
    var n = 0
    for c in 0..W {
      var seen = false
      for y in 0..H {
        if ((this.rows[y] >> c) & 1) == 1 { seen = true } else { if seen { n += 1 } }
      }
    }
    return n
  }

  // Spike's well variant: per column, the contiguous empty run below the FIRST cell that is empty with
  // both lateral neighbours (or walls) filled; scanning stops at the column's first filled cell.
  fn wellSum(): i32 {
    var sum = 0
    for c in 0..W {
      for y in 0..H {
        if ((this.rows[y] >> c) & 1) == 1 { break }
        let leftFilled = if c == 0 { 1 } else { (this.rows[y] >> (c - 1)) & 1 }
        let rightFilled = if c == W - 1 { 1 } else { (this.rows[y] >> (c + 1)) & 1 }
        if leftFilled == 1 && rightFilled == 1 {
          var yy = y
          for _d in 0..H {
            if yy < H && ((this.rows[yy] >> c) & 1) == 0 { sum += 1; yy += 1 } else { break }
          }
          break
        }
      }
    }
    return sum
  }

  // Save/restore the FULL board identity (rows + garbage masks): every planning/search simulation goes
  // through simPlace → clearFullRows, which moves the masks — a rows-only restore would corrupt them.
  fn saveRows(): List<i32> {
    var saved: List<i32> = List<i32>()
    for y in 0..H { saved.add(this.rows[y]) }
    for y2 in 0..H { saved.add(this.garbageMasks[y2]) }
    return saved
  }

  fn restoreRows(saved: List<i32>) {
    for y in 0..H { this.rows[y] = saved[y] }
    for y2 in 0..H { this.garbageMasks[y2] = saved[H + y2] }
  }

  // ── M57.1 board-shape features the Dellacherie basis cannot express ───────────────────────────────
  fn colHeight(c: i32): i32 {
    for y in 0..H {
      if ((this.rows[y] >> c) & 1) == 1 { return H - y }
    }
    return 0
  }

  // wellSum with the designated well column EXCLUDED — THE sign fix (spike S0: this term alone is worth
  // +14.7% score and 11× the tetrises, because the tetris well stops being self-penalising).
  fn wellSumExceptWell(): i32 {
    var sum = 0
    for c in 0..W {
      if c == WellCol { continue }
      for y in 0..H {
        if ((this.rows[y] >> c) & 1) == 1 { break }
        let leftFilled = if c == 0 { 1 } else { (this.rows[y] >> (c - 1)) & 1 }
        let rightFilled = if c == W - 1 { 1 } else { (this.rows[y] >> (c + 1)) & 1 }
        if leftFilled == 1 && rightFilled == 1 {
          var yy = y
          for _d in 0..H {
            if yy < H && ((this.rows[yy] >> c) & 1) == 0 { sum += 1; yy += 1 } else { break }
          }
          break
        }
      }
    }
    return sum
  }

  // Rows that are complete except the well column — i.e. rows a single vertical I would clear.
  fn tetrisReady(): i32 {
    if this.colHeight(WellCol) > 16 { return 0 }
    let wellMask = 1 << WellCol
    var n = 0
    for y in 0..H {
      if (this.rows[y] | wellMask) == FullRow && (this.rows[y] & wellMask) == 0 { n += 1 }
    }
    return n
  }

  // Empty cells sealed underneath the topmost filled cell of the well column.
  fn coveredWell(): i32 {
    for y in 0..H {
      if ((this.rows[y] >> WellCol) & 1) == 1 {
        var d = 0
        for yy in (y + 1)..H {
          if ((this.rows[yy] >> WellCol) & 1) == 0 { d += 1 }
        }
        return d
      }
    }
    return 0
  }

  // ── M57.1 tap-budget reachability (spike S3 — the owner's "can it get pieces to the side?" question) ──
  // Rows fallen by the time `taps` shifts have been issued, then the greatest stack height at which a
  // placement that far from spawn (x=5) still lands. Column 9 is 4 taps away, column 0 is 5.
  // MEASURED at L29 (1 frame/row): DAS reaches height 7, hypertapping 9–11, rolling 13, 30Hz 15 — which is
  // why DAS scores ZERO on the kill screen and rolling scores 37,135. Above these heights the wall is
  // simply unreachable, and an agent that does not know it keeps trying to feed a well it cannot feed.
  fn maxTapHeight(taps: i32): i32 {
    let g = this.gravityFrames(this.level)
    let fallen = tetDiv(taps * this.tapFramesPerShift, g)
    return H - 3 - fallen
  }

  fn setTapRate(framesPerShift: i32) {
    this.tapFramesPerShift = framesPerShift
  }

  // Dellacherie score of placing `piece` at (rot, x) on the CURRENT rows — WIDENED (M57.1).
  // Baseline terms are unchanged (−landing + eroded − rowT − colT − 4·holes) but wells now exclude the
  // well column, and the tetris-aware + reachability terms are added. Board restored; no RNG.
  // Returns −1e18 for an illegal placement.
  // Widened evaluator over the CURRENT (already-placed) rows. `simLanding`/`simEroded` must still be
  // valid — i.e. call this immediately after simPlace. SHARED by dellaScoreFor (the scripted + search
  // tiers) and by the observation planes (the net's dense target), so the teacher the net distils and
  // the evaluator the search uses can never drift apart. That drift was a live hazard in M54, where the
  // dense target was a hand-written inverse of the observation normalizers.
  fn evalAfterstate(cleared: i32): f64 {
    let holeCount = this.holes()
    var s = 0.0 - this.simLanding + this.simEroded - this.rowTransitions() - this.colTransitions() + EvalHoles * holeCount + EvalWells * this.wellSumExceptWell()
    let m5 = this.maxTapHeight(5)
    let m4 = this.maxTapHeight(4)
    let lineout = m5 < 4
    let dig = holeCount > 0
    if !lineout {
      if !dig { s = s + EvalReady * this.tetrisReady() }
      let burnW = if dig { EvalBurnDig } else { EvalBurn }
      s = s + burnW * (if cleared > 0 && cleared < 4 { cleared } else { 0 })
    }
    if dig { s = s + EvalHoleDig * holeCount }
    s = s + EvalCovered * this.coveredWell()
    s = s + EvalTetris * (if cleared == 4 { 1 } else { 0 })
    let col9 = this.colHeight(WellCol - 1) - EvalMaxSafeCol9
    if col9 > 0 { s = s + EvalCol9 * col9 }
    let overLeft = this.colHeight(0) - m5
    if overLeft > 0 { s = s + EvalInaccessible * overLeft }
    let overRight = this.colHeight(W - 1) - m4
    if overRight > 0 { s = s + EvalInaccessible * overRight }
    return s
  }

  // Widened evaluator score of placing `piece` at (rot, x) on the CURRENT rows (M57.1).
  // Board restored; no RNG. Returns -1e18 for an illegal placement.
  fn dellaScoreFor(piece: i32, rot: i32, x: i32): f64 {
    let y = this.dropY(piece, rot, x)
    if y < 0 { return -1.0e18 }
    let saved = this.saveRows()
    let cleared = this.simPlace(piece, rot, x, y)
    let s = this.evalAfterstate(cleared)
    this.restoreRows(saved)
    return s
  }

  // Best Dellacherie placement value of `piece` on the current rows (−1e18 when the piece cannot land —
  // dying scores as badly as it should in the search).
  fn bestDellaFor(piece: i32): f64 {
    var best = -1.0e18
    for r in 0..this.rotCount[piece] {
      for x in 0..(W - this.rotW[piece * 4 + r] + 1) {
        let s = this.dellaScoreFor(piece, r, x)
        if s > best { best = s }
      }
    }
    return best
  }

  // ── Observation (PRD §3.4) — 454 floats: 200 board cells + 7 current + 7 next one-hots + six
  // 40-wide per-action planes (landing/20, eroded/8, ΔrowT/20, ΔcolT/20, Δholes/10, Δwells/20;
  // illegal action ⇒ 0 in every plane). Plane-major like the other solvers.
  fn buildObservation(): List<f64> => this.buildObservationFor(this.current, this.next)

  fn buildObservationFor(curPiece: i32, nextPiece: i32): List<f64> {
    var obs: List<f64> = List<f64>()
    for y in 0..H {
      for c in 0..W { obs.add(if ((this.rows[y] >> c) & 1) == 1 { 1.0 } else { 0.0 }) }
    }
    for p in 0..PieceCount { obs.add(if p == curPiece { 1.0 } else { 0.0 }) }
    for p2 in 0..PieceCount { obs.add(if p2 == nextPiece { 1.0 } else { 0.0 }) }

    let preRowT = this.rowTransitions()
    let preColT = this.colTransitions()
    let preHoles = this.holes()
    let preWells = this.wellSum()
    let preWellsExc = this.wellSumExceptWell()

    // M57.5c — the plane layout is BACKWARD-COMPATIBLE by design. Planes 0-5 are byte-for-byte the M54
    // basis (same quantities, same divisors, same order), so they occupy exactly observation indices
    // 214..453 — the whole of the old 454-float observation. That lets DuelingQNet.GrowInput transplant
    // the shipped M54 net (campaign eval 83,265) into the wider net FUNCTION-PRESERVINGLY: the old
    // weights keep their meaning, the new planes start at zero, so training begins from the best net we
    // have rather than from scratch. Four from-scratch runs on the widened basis all peaked around
    // 9-15K and then decayed (training journal), which is why this re-orientation exists.
    // Planes 6-15 carry the tetris-aware terms, ALREADY GATED so the dense target stays LINEAR in them
    // (a piecewise target only fitted to R^2 0.54, and spike s7 showed every evaluator tops out 100% of
    // episodes at that accuracy).
    var feat: List<f64> = List<f64>()
    for _a in 0..(ActionCount * ObsPlanes) { feat.add(0.0) }
    for a in 0..ActionCount {
      let rot = this.actionRot(a)
      let x = this.actionCol(a)
      if rot >= this.rotCount[curPiece] { continue }
      let y = this.dropY(curPiece, rot, x)
      if y < 0 { continue }
      let saved = this.saveRows()
      let cleared = this.simPlace(curPiece, rot, x, y)
      let holeCount = this.holes()
      let m5 = this.maxTapHeight(5)
      let m4 = this.maxTapHeight(4)
      let dig = holeCount > 0
      let lineout = m5 < 4
      let col9 = this.colHeight(WellCol - 1) - EvalMaxSafeCol9
      let overLeft = this.colHeight(0) - m5
      let overRight = this.colHeight(W - 1) - m4
      let inacc = (if overLeft > 0 { overLeft } else { 0 }) + (if overRight > 0 { overRight } else { 0 })
      let burnLines = if cleared > 0 && cleared < 4 { cleared } else { 0 }
      let b = a * ObsPlanes
      // planes 0-5: the M54 basis, unchanged (deltas, original divisors)
      feat[b] = this.simLanding / 20.0
      feat[b + 1] = this.simEroded / 8.0
      feat[b + 2] = (this.rowTransitions() - preRowT) / 20.0
      feat[b + 3] = (this.colTransitions() - preColT) / 20.0
      feat[b + 4] = (holeCount - preHoles) / 10.0
      feat[b + 5] = (this.wellSum() - preWells) / 20.0
      // planes 6-15: the M57 tetris-aware terms, pre-gated
      feat[b + 6] = (if lineout || dig { 0 } else { this.tetrisReady() }) / 4.0
      feat[b + 7] = this.coveredWell() / 10.0
      feat[b + 8] = (if lineout || dig { 0 } else { burnLines }) / 4.0
      feat[b + 9] = if cleared == 4 { 1.0 } else { 0.0 }
      feat[b + 10] = (if col9 > 0 { col9 } else { 0 }) / 10.0
      feat[b + 11] = inacc / 10.0
      feat[b + 12] = (if lineout { 0 } else { if dig { burnLines } else { 0 } }) / 4.0
      feat[b + 13] = (if dig { holeCount } else { 0 }) / 20.0
      feat[b + 14] = 1.0
      // the evaluator penalises wells OUTSIDE the well column; plane 5 keeps the M54 meaning for the
      // warm start, so the dense target reads this one instead.
      feat[b + 15] = (this.wellSumExceptWell() - preWellsExc) / 20.0
      this.restoreRows(saved)
    }
    for f in 0..ObsPlanes {
      for a2 in 0..ActionCount { obs.add(feat[a2 * ObsPlanes + f]) }
    }
    return obs
  }

  // ── Scripted tiers — sanity gates, eval bars, and the site's watch tiers ─────────────────────────────────

  // Uniform-random legal placement. Takes its OWN rng so policy sampling never touches the piece stream.
  fn randomAction(policyRng: PgTetRng): i32 {
    var legal: List<i32> = List<i32>()
    for a in 0..ActionCount { if this.placementLegal(a) { legal.add(a) } }
    if legal.count == 0 { return -1 }
    return legal[policyRng.nextInt(legal.count)]
  }

  // The Dellacherie tier: argmax placement by the canonical evaluator (first strict improvement wins ties
  // — the spike's iteration order: rotation-major, then column).
  fn dellacherieAction(): i32 {
    var best = -1
    var bestScore = -1.0e18
    for a in 0..ActionCount {
      if !this.placementLegal(a) { continue }
      let s = this.dellaScoreFor(this.current, this.actionRot(a), this.actionCol(a))
      if s > bestScore { bestScore = s; best = a }
    }
    return best
  }

  // Search tier over the Dellacherie evaluator (PRD §3.8/M54.4): beamA over first-ply placement scores,
  // beamB over the KNOWN next piece's placements, then expectimax (mean over the 7 pieces' best
  // placement) for the unknown third piece. Deterministic, no RNG, board restored.
  fn dellaSearchAction(beamA: i32, beamB: i32): i32 {
    var v1: List<f64> = List<f64>()
    for a in 0..ActionCount {
      v1.add(if this.placementLegal(a) { this.dellaScoreFor(this.current, this.actionRot(a), this.actionCol(a)) } else { -1.0e18 })
    }

    var beam: List<i32> = List<i32>()
    for _pick in 0..beamA {
      var bestA = -1
      var bestV = -1.0e18
      for a2 in 0..ActionCount {
        if !this.placementLegal(a2) { continue }
        var taken = false
        for j in 0..beam.count { if beam[j] == a2 { taken = true } }
        if !taken && v1[a2] > bestV { bestV = v1[a2]; bestA = a2 }
      }
      if bestA < 0 { break }
      beam.add(bestA)
    }
    if beam.count == 0 { return -1 }

    var best = beam[0]
    var bestTotal = -1.0e18
    for bi in 0..beam.count {
      let a3 = beam[bi]
      let saved = this.saveRows()
      this.simPlace(this.current, this.actionRot(a3), this.actionCol(a3), this.dropY(this.current, this.actionRot(a3), this.actionCol(a3)))

      // Second ply: the known next piece — collect its placement scores, keep the top beamB.
      var v2: List<f64> = List<f64>()
      var r2s: List<i32> = List<i32>()
      var x2s: List<i32> = List<i32>()
      for r2 in 0..this.rotCount[this.next] {
        for x2 in 0..(W - this.rotW[this.next * 4 + r2] + 1) {
          let s2 = this.dellaScoreFor(this.next, r2, x2)
          if s2 > -1.0e17 {
            v2.add(s2)
            r2s.add(r2)
            x2s.add(x2)
          }
        }
      }

      var maxB = -1.0e18
      var used: List<bool> = List<bool>()
      for _i in 0..v2.count { used.add(false) }
      for _pick2 in 0..beamB {
        var bi2 = -1
        var bv2 = -1.0e18
        for i2 in 0..v2.count { if !used[i2] && v2[i2] > bv2 { bv2 = v2[i2]; bi2 = i2 } }
        if bi2 < 0 { break }
        used[bi2] = true
        let saved2 = this.saveRows()
        this.simPlace(this.next, r2s[bi2], x2s[bi2], this.dropY(this.next, r2s[bi2], x2s[bi2]))
        var acc = 0.0
        for p in 0..PieceCount { acc += this.bestDellaFor(p) }
        this.restoreRows(saved2)
        let total2 = v2[bi2] + acc / PieceCount
        if total2 > maxB { maxB = total2 }
      }

      this.restoreRows(saved)
      let total = v1[a3] + maxB
      if total > bestTotal { bestTotal = total; best = a3 }
    }
    return best
  }

  // Trained-net tier: masked greedy argmax over Q for the current observation.
  fn netAction(net: PgTetDuelingNet): i32 {
    let q = net.forward(this.buildObservation())
    var best = -1
    var bestQ = -1.0e18
    for a in 0..ActionCount {
      if !this.placementLegal(a) { continue }
      if q[a] > bestQ { bestQ = q[a]; best = a }
    }
    return best
  }

  // Net+search tier (PRD §3.9): beam over Q, one-ply rollout over the KNOWN next piece, expectimax over
  // the unknown next-next via 7 forwards. γ=0 semantics (M54.3 pivot): Q(s,a) is the net's estimate of the
  // placement's own Dellacherie-basis value (line rewards live inside eroded), so the two-ply value is
  // Q(s,a) + E[max_b Q(s′,b)] — own value plus best follow-up, the dellaSearchAction shape. Adding the raw
  // line reward instead (the pre-pivot γ>0 formulation) double-ignores the placement's own board damage —
  // measured at −65% survival vs the plain net tier before this fix.
  fn netSearchAction(net: PgTetDuelingNet, beamWidth: i32): i32 {
    let q1 = net.forward(this.buildObservation())

    var beam: List<i32> = List<i32>()
    for _pick in 0..beamWidth {
      var bestA = -1
      var bestQ = -1.0e18
      for a in 0..ActionCount {
        if !this.placementLegal(a) { continue }
        var taken = false
        for j in 0..beam.count { if beam[j] == a { taken = true } }
        if !taken && q1[a] > bestQ { bestQ = q1[a]; bestA = a }
      }
      if bestA < 0 { break }
      beam.add(bestA)
    }
    if beam.count == 0 { return -1 }

    var best = beam[0]
    var bestVal = -1.0e18
    for bi in 0..beam.count {
      let a2 = beam[bi]
      let rot = this.actionRot(a2)
      let x = this.actionCol(a2)
      let saved = this.saveRows()
      this.simPlace(this.current, rot, x, this.dropY(this.current, rot, x))

      // The next piece is known and becomes current; expectimax over the 7 equally likely previews.
      var acc = 0.0
      for p in 0..PieceCount {
        let q2 = net.forward(this.buildObservationFor(this.next, p))
        var bestQ2 = 0.0
        var any = false
        for a3 in 0..ActionCount {
          let rot3 = this.actionRot(a3)
          if rot3 >= this.rotCount[this.next] { continue }
          if this.dropY(this.next, rot3, this.actionCol(a3)) < 0 { continue }
          if !any || q2[a3] > bestQ2 { bestQ2 = q2[a3]; any = true }
        }
        acc += bestQ2
      }
      this.restoreRows(saved)

      let val = q1[a2] + acc / PieceCount
      if val > bestVal { bestVal = val; best = a2 }
    }
    return best
  }
}

// ── Dueling-Q net inference (single-source forward; identical math to the other solvers' nets) ─────────────
// INFERENCE ONLY — training stays on the SDK. Weights arrive float32 from the checkpoint parser
// (C# DuelingQNetCheckpoint / tetris-net.ts); trunk tensors FLAT (layers concatenated).
class PgTetDuelingNet {
  var inputSize: i32
  var actions: i32
  var hidden: List<i32>
  var trunkWFlat: List<f64>
  var trunkBFlat: List<f64>
  var valueW: List<f64>
  var valueB: List<f64>
  var advW: List<f64>
  var advB: List<f64>

  constructor(inputSize: i32, actions: i32, hidden: List<i32>, trunkWFlat: List<f64>, trunkBFlat: List<f64>, valueW: List<f64>, valueB: List<f64>, advW: List<f64>, advB: List<f64>) {
    this.inputSize = inputSize
    this.actions = actions
    this.hidden = hidden
    this.trunkWFlat = trunkWFlat
    this.trunkBFlat = trunkBFlat
    this.valueW = valueW
    this.valueB = valueB
    this.advW = advW
    this.advB = advB
  }

  fn forward(obs: List<f64>): List<f64> {
    var x = obs
    var prev = this.inputSize
    var wOff = 0
    var bOff = 0
    for l in 0..this.hidden.count {
      let h = this.hidden[l]
      x = relu(linear(x, this.trunkWFlat, wOff, this.trunkBFlat, bOff, prev, h))
      wOff += prev * h
      bOff += h
      prev = h
    }
    let value = linear(x, this.valueW, 0, this.valueB, 0, prev, 1)
    let adv = linear(x, this.advW, 0, this.advB, 0, prev, this.actions)

    var sumA = 0.0
    for k in 0..this.actions { sumA += adv[k] }
    let meanA = sumA / this.actions
    let v = value[0]

    var q: List<f64> = List<f64>()
    for k2 in 0..this.actions { q.add(adv[k2] + (v - meanA)) }
    return q
  }

  static fn linear(x: List<f64>, w: List<f64>, wOff: i32, b: List<f64>, bOff: i32, inDim: i32, outDim: i32): List<f64> {
    var out: List<f64> = List<f64>()
    for o in 0..outDim {
      var s = b[bOff + o]
      for i in 0..inDim { s += x[i] * w[wOff + i * outDim + o] }
      out.add(s)
    }
    return out
  }

  static fn relu(x: List<f64>): List<f64> {
    var out: List<f64> = List<f64>()
    for v in x { out.add(Math.max(0.0, v)) }
    return out
  }
}
